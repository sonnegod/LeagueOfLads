# Copy this file to .env for local development. Do not commit .env.
ENVIRONMENT=DEV
SERVER_PORT=3000
FRONTEND_PORT=5173

# Steam Web API key used to fetch a signed-in user's Steam profile.
STEAM_API_KEY=replace_with_your_development_key

# Analytics defaults to db/ locally and /root/LeagueOfLads/db/ in production.
# Leave blank to detect the first real signup season (legacy imported seasons are excluded).
ANALYTICS_FIRST_SEASON_ID=
# Optional absolute path overrides:
# ANALYTICS_DB=
# ANALYTICS_LEAGUE_DB=
# ANALYTICS_PUBLIC_DB=

# Betting defaults beside LadsData.db. Accepted prices remain frozen.
# BETTING_DB=
BETTING_ODDS_REDUCTION=0.10
BETTING_FIXTURE_LOOKAHEAD_DAYS=7
# Discord scheduling is a separate read-only worker; never expose its token.
# DISCORD_TOKEN=
DISCORD_SCHEDULE_CHANNEL_ID=626493827544514580
# Site usage analytics defaults to enabled in PROD and disabled in DEV.
# Set true to test real collection locally, or false to disable it in production.
# SITE_ANALYTICS_ENABLED=true
